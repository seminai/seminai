  "scripts": {
    "predev": "npm run generate && npm run datasets:sync && npm run datasets:build",
    "dev": "vite",
    "prebuild": "npm run generate && npm run datasets:sync && npm run datasets:build",
    "build": "vite build && tsc -b",
    "prebuild:docker": "npm run generate",
    "build:docker": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "generate": "npm run prisma:generate && npm run api:codegen",
    "prisma:generate": "prisma generate",
    "api:codegen": "orval",
    "api:generate": "npm --prefix ../backend run swagger:export && npm run api:codegen",
    "datasets:sync": "node scripts/sync-crop-catalog.mjs",
    "datasets:build": "node scripts/build-cultivar-index.mjs",
    "clean": "rimraf dist src/generated"
  },
