# Optional Docker web settings. AI is configured in the app, not required here.
SEMINAI_BIND_HOST=127.0.0.1
SEMINAI_PORT=8081
SEMINAI_DATA_DIR=./data
SEMINAI_IMAGE=seminai:local
PUBLIC_BASE_URL=http://localhost:8081
ACCESS_MODE=lan

# To allow other devices on your LAN, set SEMINAI_BIND_HOST=0.0.0.0 and
# PUBLIC_BASE_URL=http://<server-LAN-IP>:8081, then recreate the app container.
# For a public host, use HTTPS through a reverse proxy and ACCESS_MODE=public.
