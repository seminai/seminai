{
  "name": "@seminai/backend",
  "version": "1.0.0",
  "description": "Seminai backend — AI-assisted agronomic management API (Express + Prisma + AI agents).",
  "private": true,
  "type": "module",
  "main": "./src/infrastructure/http/server.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seminai/seminai.git"
  },
  "scripts": {
    "kill-port": "lsof -ti:8081 | xargs kill -9 2>/dev/null || true",
    "dev": "npm run kill-port && sleep 1 && tsx watch src/infrastructure/http/server.ts",
    "dev:watch": "tsx watch src/infrastructure/http/server.ts",
    "build": "tsc && npm run build:copy-llm-pricing && npm run build:copy-public",
    "build:copy-llm-pricing": "mkdir -p dist/infrastructure/services/llm_costs && cp src/infrastructure/services/llm_costs/llm_cost.json src/infrastructure/services/llm_costs/openrouter_pricing.json dist/infrastructure/services/llm_costs/",
    "build:copy-public": "cp -r src/infrastructure/http/public dist/infrastructure/http/",
    "start": "node dist/infrastructure/http/server.js",
    "studio:kill-port": "lsof -ti:2024 | xargs kill -9 2>/dev/null || true",
    "studio": "npm run studio:kill-port && langgraphjs dev --port 2024",
    "studio:trace": "LANGFUSE_TRACING=true npm run studio",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "swagger:export": "npx tsx scripts/export-swagger.ts",
    "audit:workspace-kinds": "npx tsx scripts/audit-workspace-company-kinds.ts",
    "test": "jest --watchman=false --passWithNoTests",
    "test:unit": "jest --config jest.config.cjs --watchman=false --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.cjs --watchman=false --runInBand",
    "test:int:all": "jest --config jest.integration.config.cjs --watchman=false --runInBand",
    "test:int:all:env": "node scripts/test-env.mjs test-all",
    "test:int:public": "jest --config jest.integration.public.config.cjs --watchman=false --runInBand",
    "test:int:public:env": "node scripts/test-env.mjs test-public",
    "test:int:private:env": "node scripts/test-env.mjs test-private",
    "test:int:fast": "jest --config jest.integration.fast.config.cjs --watchman=false --runInBand",
    "test:int:fast:env": "node scripts/test-env.mjs test-fast",
    "test:int:llm": "jest --config jest.integration.llm.config.cjs --watchman=false --runInBand",
    "test:int:benchmark": "jest --config jest.integration.benchmark.config.cjs --watchman=false --runInBand",
    "test:int:ocr": "jest --config jest.integration.ocr.config.cjs --watchman=false --runInBand",
    "test:int:quality": "node scripts/test-env.mjs test-quality",
    "test:int:quality:live": "node scripts/test-env.mjs test-quality-live",
    "test:int:changed": "bash ./scripts/run-related-integration.sh",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pricing:sync-openrouter": "npx tsx scripts/sync-openrouter-pricing.ts",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test:env:up": "node scripts/test-env.mjs up",
    "test:env:down": "node scripts/test-env.mjs down",
    "test:env:reset": "node scripts/test-env.mjs reset",
    "test:env:migrate": "node scripts/test-env.mjs migrate",
    "clean": "rimraf dist",
    "config:init": "node ./bin/init-config.js",
    "ground": "npm run build && node dist/ground-test/cli.js",
    "ground:zero": "tsx src/ground-test/match_0.ts",
    "vector-upload": "npm run build && node dist/infrastructure/services/agents/vector_search_agent/index.js",
    "db:dump": "tsx src/utils/db-dump.ts",
    "db:restore": "tsx src/utils/db-restore.ts",
    "worker": "node ./dist/infrastructure/worker/worker.js",
    "worker:dev": "tsx watch src/infrastructure/worker/worker.ts",
    "cleanup:redis": "tsx scripts/cleanup/cleanupOrphanJobsRedis.ts",
    "cleanup:redis:dry": "tsx scripts/cleanup/cleanupOrphanJobsRedis.ts --dry-run",
    "cleanup:dosage": "tsx scripts/cleanup/cleanupOrphanDosageAgentJobs.ts",
    "cleanup:dosage:dry": "tsx scripts/cleanup/cleanupOrphanDosageAgentJobs.ts --dry-run",
    "cleanup:all:dry": "npm run cleanup:redis:dry && npm run cleanup:dosage:dry",
    "cleanup:all": "npm run cleanup:redis && npm run cleanup:dosage"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "preferGlobal": false,
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "authentication"
  ],
  "author": "Seminai contributors",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@google-cloud/storage": "7.17.3",
    "@langchain/anthropic": "1.3.17",
    "@langchain/community": "1.0.5",
    "@langchain/core": "1.1.31",
    "@langchain/langgraph": "1.2.1",
    "@langchain/langgraph-checkpoint-postgres": "1.0.1",
    "@langchain/openai": "1.1.3",
    "@langchain/qdrant": "1.0.1",
    "@langchain/textsplitters": "1.0.1",
    "@langfuse/langchain": "5.4.1",
    "@langfuse/otel": "5.4.1",
    "@langfuse/tracing": "5.4.1",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@opentelemetry/sdk-trace-node": "2.7.1",
    "@paddlejs-models/ocr": "1.2.4",
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "@qdrant/js-client-rest": "1.16.1",
    "@socket.io/redis-adapter": "8.3.0",
    "@tavily/core": "0.5.13",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/multer": "2.0.0",
    "@types/node-geocoder": "4.2.6",
    "@types/socket.io": "3.0.1",
    "adm-zip": "0.5.16",
    "axios": "1.6.7",
    "bcryptjs": "2.4.3",
    "bull-board": "2.1.3",
    "bullmq": "5.65.0",
    "canvas": "3.2.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parse": "6.1.0",
    "d3-dsv": "2.0.0",
    "dotenv": "16.4.5",
    "duck-duck-scrape": "2.2.7",
    "exifr": "7.1.3",
    "express": "4.18.2",
    "express-validator": "7.0.1",
    "glob": "10.3.10",
    "google-auth-library": "10.6.1",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jsonwebtoken": "9.0.2",
    "langchain": "1.2.30",
    "lru-cache": "10.2.0",
    "mongodb": "7.0.0",
    "multer": "2.0.2",
    "node-geocoder": "4.4.1",
    "nodemailer": "7.0.11",
    "pdf-parse": "2.4.5",
    "pdf.js-extract": "0.1.5",
    "pg": "8.20.0",
    "posthog-node": "5.35.13",
    "proj4": "2.20.3",
    "qrcode": "1.5.3",
    "shapefile": "0.6.6",
    "socket.io": "4.8.3",
    "speakeasy": "2.0.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.0",
    "undici": "7.22.0",
