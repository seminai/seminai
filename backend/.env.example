# App
APP_NAME="Seminai"

# Server
PORT=8081
NODE_ENV=development

# Optional local-only test fixtures. Must be an absolute directory outside this repository.
# SEMINAI_FIXTURES_DIR=/absolute/path/outside/seminai

# Backend URL (for email verification links)
BACKEND_URL="http://localhost:8081"
FRONTEND_URL="http://localhost:5173"

# Redis (local dev)
REDIS_URL=redis://localhost:6379
# Redis (production — Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Disable the spawn_subagent BullMQ queue (dev without Redis). When true, the
# spawn_subagent tool short-circuits and tells the model to fall back to the
# inline calculate_dosage + optimize_dosage workflow. Leave unset in production.
# SKIP_QUEUE=true

# Workspace-kind chat routing (rollout flag — see docs/WORKSPACE_KIND_ROLLOUT.md).
# Default off = legacy: chat always uses the dosage (agricultural) agent, workspaceId optional.
# When "true": chat routes by workspace.kind (AGRICULTURAL → dosage, MANUFACTURING → manufacture
# agent) and workspaceId becomes REQUIRED (missing → 400 WORKSPACE_ID_REQUIRED). Flip per-environment
# only after the pre-flip audit (npm run audit:workspace-kinds) is clean.
WORKSPACE_KIND_ROUTING=false

# PostgreSQL (local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seminai-be?schema=public&sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/seminai-be?schema=public&sslmode=disable"

# JWT / encryption — generated under DATA_DIR/secrets on first boot if unset
# JWT_SECRET=
# ENCRYPTION_SECRET=
JWT_EXPIRES_IN="1d"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging
LOG_LEVEL="debug"

# CORS — comma-separated allowed origins (FRONTEND_URL is also merged if set)
# CORS_ORIGIN (singular) is accepted as an alias for legacy deployments
# API_PUBLIC_ORIGIN and BACKEND_URL are also merged when set.
# Same-host requests (e.g. /developer portal) are always allowed.
# Example for production:
# CORS_ORIGINS=https://app.seminai.tech,http://localhost:5173
# API_PUBLIC_ORIGIN=http://localhost:8081
CORS_ORIGINS=

# Email (Gmail app password)
EMAIL_USER=
EMAIL_PASSWORD=

# LLM — the setup wizard persists the provider; environment overrides the database.
# Local-first default after setup is Ollama. Leave LLM_GATEWAY unset for that path.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Seminai
# LLM_GATEWAY=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_DEFAULT_MODEL=qwen3.5:4b
LLM_FAST_MODEL=openai/gpt-4o-mini
LLM_STRONG_MODEL=openai/gpt-4o
LLM_VISION_MODEL=openai/gpt-4o
LLM_LABEL_EXTRACTION_MODEL=openai/gpt-4o
LLM_AUDIO_MODEL=google/gemini-2.5-flash

# Langfuse local tracing (self-hosted UI on http://localhost:3000) — see studio/README.md
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# OpenAI native APIs (embeddings RAG, chat when LLM_GATEWAY=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic native API (chat Claude when LLM_GATEWAY=openai and model is claude-*)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# PostHog (product + LLM analytics, EU Cloud). Leave POSTHOG_API_KEY empty to
# disable analytics entirely (dev/test → no-op adapter, no network calls).
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Runtime role and local storage
APP_MODE=all
DATA_DIR=./data
# Directory of the built SPA. When set, Express serves it and falls back to index.html.
SPA_DIR=
STORAGE_DRIVER=local
FILE_URL_SIGNING_SECRET=

# Optional S3-compatible storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Qdrant (vector DB) — local: http://127.0.0.1:6333 via `docker compose up -d qdrant`
QDRANT_API_KEY=
QDRANT_URL=http://127.0.0.1:6333

# Tavily (search)
TAVILY_API_KEY=

# Base URL (production backend)
BASE_URL=

# OCR services (Mistral OCR only — not routed via OpenRouter)
DATALAB_API_KEY=
JINA_API_KEY=
MISTRAL_API_KEY=
FORMIT_API_URL=

# SMTP (local dev — Mailhog)
SMTP_HOST="localhost"
SMTP_PORT=1025

# WhatsApp (Evolution API)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_URL=

# Email Inbound Connector (SendGrid Inbound Parse)
SENDGRID_INBOUND_WEBHOOK_TOKEN=
EMAIL_INBOUND_DOMAIN=inbox.seminai.app
EMAIL_INBOUND_FROM_ADDRESS=ai@seminai.app
EMAIL_INGEST_MAX_ATTACHMENTS=20
EMAIL_INGEST_MAX_TOTAL_SIZE_BYTES=52428800
EMAIL_INGEST_MAX_PER_FILE_BYTES=26214400
EMAIL_INGEST_MAX_DISAMBIGUATION_COMPANIES=10
EMAIL_INGEST_FRONTEND_CHAT_URL_TEMPLATE=https://app.seminai.app/chat/{threadId}

# ScraperGraph
SCRAPERGRAPH_API_KEY=

# Legacy dosage operation overrides. Values can be provider hints or direct model slugs.
DOSAGE_ORCHESTRATOR_PROVIDER=openrouter
DOSAGE_CROP_MATCHER_PROVIDER=openrouter

# OCR service
DOTS_OCR_BASE_URL=

# BDF (Banca Dati Fitofarmaci)
URL_SERVER_BDF=
USERNAME_BDF=
PASSWORD_BDF=

# Admin access
WHITE_LIST_EMAILS=
PASSWORD_PROTECTED_ROUTES=<generate-a-strong-random-string>

# LangGraph
LANGGRAPH_CHECKPOINTER_SCHEMA=langgraph

# Invite code for registration
INVITE_CODE=

# Extraction API (public B2B document extraction)
EXTRACTION_API_INVITE_CODE=
EXTRACTION_API_TRIAL_PAGES=10
EXTRACTION_API_MARGIN=0.30

# QDC (Quaderno di Campagna — Image Line) service credentials.
# IMAGE_LINE_CLIENT_ID = "CODICE CLIENTE" (OAuth client_id) — the only credential
#   the QDC v2 "integrazioni" auth flow needs; used by the qdc_* agent tools
#   (per-user Settings.qdcApiKey is a legacy fallback when this is unset).
# IMAGE_LINE_API_KEY = "SECRET KEY SERVIZIO" — NOT used by the v2 integrazioni
#   flow; kept for other Image Line services.
IMAGE_LINE_CLIENT_ID=
IMAGE_LINE_API_KEY=
# Optional override for the real-API integration tests
# (src/integration-test/qdc-*.integration.test.ts — they fall back to
# IMAGE_LINE_CLIENT_ID and are skipped when both are unset).
# SAFETY: keep QDC tests READ-ONLY; writes only against the test company ("AZIENDA PROVA").
QDC_TEST_CLIENT_ID=
