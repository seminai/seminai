{
  "name": "@seminai/mcp-connector",
  "version": "1.0.0",
  "description": "MCP connector exposing Seminai REST API and QDC Image Line APIs as tools for Claude and ChatGPT",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "seminai-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "start": "node dist/cli.js",
    "start:http": "node dist/http.js",
    "dev": "tsx --watch src/cli.ts",
    "dev:http": "tsx --watch src/http.ts",
    "test": "jest --watchman=false --passWithNoTests",
    "test:unit": "jest --config jest.config.cjs --watchman=false --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.cjs --watchman=false --runInBand",
    "test:all": "npm run test:unit && npm run test:integration",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "4.22.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.1.0",
    "@typescript-eslint/parser": "7.1.0",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.18",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "jest-util": "29.7.0",
    "ts-jest": "29.4.9",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
