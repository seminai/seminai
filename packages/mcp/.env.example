# Base URL of the Seminai backend (no trailing slash).
SEMINAI_API_BASE_URL=http://localhost:8081

# JWT obtained from POST /auth/login. Required for stdio (Claude Desktop local).
# HTTP/OAuth mode obtains a per-user JWT during the OAuth login instead.
SEMINAI_API_TOKEN=

# --- Remote HTTP / OAuth (Claude.ai custom connector, ChatGPT developer mode) ---
# PUBLIC_BASE_URL=http://localhost:8080
# MCP_OAUTH_SIGNING_KEY=change-me-to-a-long-random-secret
# PORT=8080
# REDIS_URL=

# Optional MCP server identity (rarely needs overriding).
# SEMINAI_MCP_SERVER_NAME=seminai
# SEMINAI_MCP_SERVER_VERSION=0.0.1

# --- Live integration test only ---
# Activate by setting SEMINAI_LIVE_TEST=1 when running `bun run test:integration`.
# The credentials below are used to log in and obtain a fresh JWT for each run.
# SEMINAI_LIVE_TEST=1
# SEMINAI_LIVE_BASE_URL=http://localhost:8081
# SEMINAI_LIVE_EMAIL=
# SEMINAI_LIVE_PASSWORD=
